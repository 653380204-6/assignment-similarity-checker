# === APP CONFIG ===
APP_NAME=PDF Plagiarism Detection API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8089
LOG_LEVEL=info

# === SUPABASE CONFIG ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bucket name used by the system
SUPABASE_BUCKET=assignments
SUPABASE_DB_TABLE=documents_duplicate

# === VECTOR DB (Pinecone) ===
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east1-gcp

# === MODEL SETTINGS ===
TEXT_MODEL_NAME=sentence-transformers/LaBSE
IMAGE_MODEL_NAME=openai/clip-vit-base-patch32
OCR_ENABLE=true
OCR_LANG=eng+tha
USE_TF_IDF=true
USE_NGRAM=true
NGRAM_N=3

# === SIMILARITY THRESHOLDS ===
THRESH_TEXT_SEMANTIC=0.80
THRESH_TEXT_LEXICAL=0.75
THRESH_IMAGE_SIM=0.80
WEIGHT_TEXT=0.50
WEIGHT_IMAGE=0.50

# === STORAGE ===
TMP_DIR=./tmp
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=50

# === FRONTEND CORS ===
FRONTEND_ORIGINS=http://localhost:3000
